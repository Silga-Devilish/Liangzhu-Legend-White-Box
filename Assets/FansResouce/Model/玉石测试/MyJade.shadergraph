    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "730aaba5da6f48f5b88c83bdccc8b7b5",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Translucency_float (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -114.0,
            "y": 1414.0,
            "width": 263.33331298828127,
            "height": 448.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "056e98f1b32f4e60832c83d73d9968ac"
        },
        {
            "m_Id": "a46942e3b64d4b9e899ad2801eeaacb2"
        },
        {
            "m_Id": "782c010f82ba47699ab2ba63693961cf"
        },
        {
            "m_Id": "ec8f6e509abc44349ff984bfd0727a8a"
        },
        {
            "m_Id": "3b6021a2413b40f698e07c94791d40b8"
        },
        {
            "m_Id": "41b6a965a1084ebcbe79856abca5ed15"
        },
        {
            "m_Id": "48779776b42643e580dbf57dfc7cd650"
        },
        {
            "m_Id": "fb7bd0c93f20474fa8729615d2669f62"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "Translucency_float",
    "m_FunctionSource": "c31450f031c0b1c43a3610e2b63f1499",
    "m_FunctionBody": "float3 L = -LightDirection;        // ← 加负号，翻转方向\r\nfloat3 N = WorldNormal;\r\nfloat3 V = WorldViewDir;\r\n\r\nfloat3 H = L + NormalPerturbation * N;\r\nfloat I = pow(saturate(dot(V, -H)), Power) * Strength;\r\n\r\nEmission = I * TranslucencyColor;"
}

